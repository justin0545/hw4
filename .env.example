# Campus Customs agent: environment settings
#
# Only needed if PORTKEY_API_KEY is NOT already set in your environment.
# Copy this file to `.env` (here in the project root, or in backend/) and fill in your own key:
#
#     copy .env.example .env        (Windows)
#     cp .env.example .env          (macOS / Linux)
#
# Every value below is a PLACEHOLDER. Never put a real key in this file, and
# never commit or share the real .env.
#
# Where the agent looks for the key (first hit wins, see tools.load_credentials):
#     1. the real environment
#     2. backend/.env
#     3. .env in the project root

# Portkey: every model call goes through the course gateway (same as Homework 3)
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional overrides
# PORTKEY_BASE_URL=https://api.portkey.ai/v1
# PORTKEY_MODEL=gpt-5.6-luna-2026-07-09
# PORTKEY_VIRTUAL_KEY=your-virtual-key-slug
# PORTKEY_PROVIDER=openai
